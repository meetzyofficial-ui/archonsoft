# Public site origin — used for canonical URLs, sitemap entries and Open Graph
# image origins. Must be the real origin in production.
NEXT_PUBLIC_SITE_URL=https://archonsoft.tr

# The address printed on the site (footer, contact page, mobile menu) and used
# for the form's mailto fallback. Leave it unset until a real mailbox exists:
# every mailto on the site stays hidden rather than shipping a dead link, and
# visitors are routed to the contact form instead.
NEXT_PUBLIC_CONTACT_EMAIL=

# Contact form delivery. Leave unset to run the site without a mail provider:
# the API route responds with a 503 and the form says so plainly. No submission
# is ever reported as successful unless one actually happened.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Archon Soft <site@archonsoft.tr>

# Archon World — client requests from the offices (`/api/lead`).
# The email goes to LEAD_TO_EMAIL, falling back to CONTACT_TO_EMAIL, then
# info@archonsoft.tr; it is sent with RESEND_API_KEY / CONTACT_FROM_EMAIL above.
LEAD_TO_EMAIL=info@archonsoft.tr

# Persistence. With a Firebase service account every lead is written to the
# `world_leads` collection through the Firestore REST API; without one the
# lead still goes out by email and WhatsApp (and, outside production, is
# appended to .qa/leads.jsonl). Paste the private key with literal \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# WhatsApp Business Cloud API. Leave unset to skip (mocked to the server log
# outside production). WHATSAPP_TO defaults to 905521592002. A free-form
# text only reaches a number that wrote to the business in the last 24 h;
# set WHATSAPP_TEMPLATE to an approved template name otherwise.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO=905521592002
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=tr
